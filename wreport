#!/usr/bin/env python3
"""Launcher so the tool runs from a clone with no install step.

    ./wreport status
    ./wreport daily add < 日报.txt

Equivalent to `python3 -m wreport` with `src/` on the path.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))

from wreport.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())